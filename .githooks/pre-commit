#!/usr/bin/env bash
# Keeps the website's CV in sync with its LaTeX source.
#
# 1. If the CV source is being committed, rebuild files/CV_Aryana_Haghjoo.pdf
#    and stage it, so the PDF can never lag behind the .tex.
# 2. Stamp every link to the PDF in index.html with ?v=<hash of the staged PDF>.
#    The URL changes whenever the PDF changes, so browsers and PDF viewers
#    can't keep showing a cached old CV.
#
# Enabled per clone with:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

PDF=files/CV_Aryana_Haghjoo.pdf
SRC=(CV/kyvernitis-resume.tex CV/kyvernitis-resume.cls CV/Makefile CV/fonts)
PAGE=index.html

staged=$(git diff --cached --name-only)

# --- 1. rebuild the PDF when the CV source changes -------------------------
if printf '%s\n' "$staged" | grep -qE '^CV/(kyvernitis-resume\.(tex|cls)|Makefile|fonts/)'; then
  if ! git diff --quiet -- "${SRC[@]}"; then
    echo "pre-commit: the CV source has unstaged changes." >&2
    echo "  Stage them (git add CV/) or stash them, so the built PDF matches what is committed." >&2
    exit 1
  fi
  echo "pre-commit: CV source changed, rebuilding $PDF ..."
  if ! log=$(make -C CV 2>&1); then
    printf '%s\n' "$log" | tail -30 >&2
    echo "pre-commit: CV build failed; commit aborted." >&2
    exit 1
  fi
  git add "$PDF"
fi

# --- 2. version the PDF links in index.html ---------------------------------
v=$(git rev-parse --short=10 ":$PDF")          # hash of the PDF being committed
stamp="s#(files/CV_Aryana_Haghjoo\\.pdf)(\\?v=[0-9a-f]+)?#\\1?v=$v#g"

# staged copy (leaves any other unstaged edits to index.html alone)
old_blob=$(git rev-parse ":$PAGE")
new_blob=$(git show ":$PAGE" | sed -E "$stamp" | git hash-object -w --stdin)
if [ "$old_blob" != "$new_blob" ]; then
  git update-index --cacheinfo "100644,$new_blob,$PAGE"
  echo "pre-commit: CV links in $PAGE now point to ?v=$v"
fi
# working copy
sed -E -i "$stamp" "$PAGE"
